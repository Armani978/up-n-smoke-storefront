{
  "name": "up-n-smoke-unified-platform",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "medusa:dev": "npm --prefix medusa-backend run dev",
