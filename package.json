    "medusa:user": "npm --prefix medusa-backend run user --"
  },
  "dependencies": {
    "@medusajs/js-sdk": "^2.17.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
