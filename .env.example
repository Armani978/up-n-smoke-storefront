# Public storefront connection
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only connection and signed sessions
MEDUSA_BACKEND_URL=http://localhost:9000
AUTH_SECRET=replace-with-at-least-32-random-characters

# `next build`/`next start` always run in Next.js's internal production mode
# -- including a local test build against a local Medusa instance -- so a
# production-time guard refuses a localhost MEDUSA_BACKEND_URL unless this is
# explicitly set. Required for local `npm run build && npm run start` against
# the URL above; a real deployment must NEVER set this.
ALLOW_LOCALHOST_MEDUSA_URL=true

# Comma-separated allowlists. A valid Medusa account that is absent from all
# three lists cannot access the staff portal.
EMPLOYEE_ADMIN_EMAILS=admin@upnsmoke.local
EMPLOYEE_MANAGER_EMAILS=
EMPLOYEE_STAFF_EMAILS=

# Must match the Medusa backend's store timezone.
STORE_TIMEZONE=America/New_York

# Optional Clover import settings (used by the Medusa backend integration)
CLOVER_MERCHANT_ID=
CLOVER_ACCESS_TOKEN=
