DATABASE_URL=postgres://medusa:medusa@localhost:5432/upnsmoke_medusa
# Optional in local development. Set this in production when Redis is available.
REDIS_URL=
STORE_CORS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_CORS=http://localhost:9000,http://127.0.0.1:9000,http://localhost:3000,http://127.0.0.1:3000
AUTH_CORS=http://localhost:9000,http://127.0.0.1:9000,http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-long-random-secret
MEDUSA_PUBLIC_URL=http://localhost:9000
# Product images use Medusa's S3-compatible File Module in production. Do not use
# the local provider outside development.
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
# Pickup verification uses this IANA timezone for the date shown to staff and
# for the server-authoritative age decision. February 29 birthdays are treated
# as February 28 in non-leap years, matching New Hampshire's stated convention.
STORE_TIMEZONE=America/New_York
PICKUP_LOCATION_NAME=Manchester Counter
PICKUP_QR_TTL_DAYS=30
REQUIRE_ID_FOR_ALL_PICKUPS=true
